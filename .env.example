# Copy to .env (or /etc/huerex.env) and edit. Every value here is the default.

# --- where things live -------------------------------------------------------
# Both default to folders inside the installation; move them somewhere the
# machine's backup regime already covers.
# DB_PATH=/var/lib/huerex/huerex.sqlite
# BACKUP_DIR=/mnt/nas/huerex-backups

# --- network -----------------------------------------------------------------
HOST=0.0.0.0
PORT=4000

# On a plain-HTTP LAN this MUST be false, or the session cookie is never sent
# and nobody can sign in. Set it to true as soon as TLS is in front.
COOKIE_SECURE=false
# Turn on only when a reverse proxy sets X-Forwarded-For.
TRUST_PROXY=false

# --- sessions ----------------------------------------------------------------
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=240
MAX_LOGIN_ATTEMPTS=8
LOCKOUT_MINUTES=15

# --- nightly backup ----------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_CRON=02:30
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# --- first run ---------------------------------------------------------------
# Set this to choose the admin password yourself; leave it out and one is
# generated and printed once.
# SEED_ADMIN_PASSWORD=
